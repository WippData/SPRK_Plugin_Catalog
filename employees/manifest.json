  },
  "capabilities": {
    "needsNetwork": false,
    "needsFileAccess": false,
    "needsSecrets": false
  },
  "extensionManifests": [
    {
      "extensionId": "employees-page",
      "path": "extensions/employees-page.json"
    },
    {
      "extensionId": "payroll-settings-page",
      "path": "extensions/payroll-settings-page.json"
    },
    {
      "extensionId": "payroll-runs-page",
      "path": "extensions/payroll-runs-page.json"
    }
  ]
