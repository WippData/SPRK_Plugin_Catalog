{
  "schemaVersion": "2",
  "extensionId": "chart-template-configuration",
  "type": "plugin_configuration",
  "name": "Chart Template Configuration",
  "version": "1.0.0",
  "targets": {
    "companyScoped": true
  },
  "permissions": {
    "network": false,
    "secrets": false
  },
  "resources": [
    {
      "resourceId": "chart-template-settings",
      "kind": "configuration",
      "schemaVersion": 1,
      "scope": "company"
    }
  ],
  "definition": {
    "title": "Firm Chart of Accounts Starter",
    "description": "Connect to the read-only SPRK template service. Account creation always remains in SPRK's native review workflow.",
    "sections": [
      {
        "sectionId": "template-service-connection",
        "kind": "connection",
        "title": "Template service connection",
        "description": "The access key is stored by SPRK and is never exposed to the plugin.",
        "connection": {
          "connector": {
            "extensionId": "chart-template-connector",
            "resourceId": "chart-template-connection"
          },
          "required": true,
          "allowMultiple": false,
          "actions": [
            {
              "actionId": "configure-template-key",
              "kind": "configure_credentials",
              "label": "Enter template access key",
              "authMethodId": "template-access-key"
            }
          ]
        }
      }
    ]
  }
}
