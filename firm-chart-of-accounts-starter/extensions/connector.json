{
  "schemaVersion": "2",
  "extensionId": "chart-template-connector",
  "type": "connector",
  "name": "SPRK Chart Template Connector",
  "version": "1.0.0",
  "description": "Reads versioned chart templates from the SPRK template service.",
  "targets": {
    "companyScoped": true
  },
  "resources": [
    {
      "resourceId": "chart-template-connection",
      "kind": "connector",
      "schemaVersion": 1,
      "scope": "company"
    }
  ],
  "definition": {
    "authMethods": [
      {
        "authMethodId": "template-access-key",
        "label": "SPRK template access key",
        "type": "api_key",
        "credentialFields": [
          {
            "key": "template-access-key",
            "label": "SPRK template access key",
            "kind": "api_key",
            "required": true
          }
        ],
        "injections": [
          {
            "credentialKey": "template-access-key",
            "in": "header",
            "name": "X-SPRK-Template-Key"
          }
        ]
      }
    ],
    "api": {
      "baseUrl": "https://plugins.sprksystems.com",
      "executionPolicy": {
        "attemptTimeoutMs": 15000,
        "totalTimeoutMs": 30000,
        "retry": {
          "maxAttempts": 2,
          "initialBackoffMs": 500,
          "maxBackoffMs": 2000,
          "retryOn": ["connection_error", "timeout", "429", "500", "502", "503", "504"]
        }
      },
      "operations": [
        {
          "operationId": "get-chart-template",
          "label": "Get chart template",
          "method": "GET",
          "path": "/v1/chart-of-accounts/templates/accounts",
          "query": {
            "version": "1.0.0"
          },
          "semantics": "read",
          "authMethodIds": ["template-access-key"]
        }
      ]
    }
  }
}
