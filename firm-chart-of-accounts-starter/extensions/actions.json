{
  "schemaVersion": "2",
  "extensionId": "chart-template-actions",
  "type": "actions",
  "name": "Chart Template Actions",
  "version": "1.0.0",
  "description": "Fetches one selected chart template and stages it for native account review.",
  "targets": {
    "companyScoped": true
  },
  "definition": {
    "actions": [
      {
        "actionId": "stage-chart-template",
        "label": "Start from a firm chart template",
        "trigger": "manual",
        "inputs": [
          {
            "inputId": "template",
            "label": "Chart template",
            "description": "Choose the closest starting point. Every row can be edited or excluded before import.",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Professional services",
                "value": "professional-services"
              },
              {
                "label": "Retail and e-commerce",
                "value": "retail-ecommerce"
              },
              {
                "label": "Nonprofit",
                "value": "nonprofit"
              }
            ]
          }
        ],
        "steps": [
          {
            "id": "fetch-chart-template",
            "command": "api.execute",
            "with": {
              "connector": {
                "extensionId": "chart-template-connector",
                "resourceId": "chart-template-connection",
                "operationId": "get-chart-template"
              },
              "connectionId": "$context.connectionId",
              "requestBindings": [
                {
                  "source": "$inputs.template",
                  "in": "query",
                  "name": "template"
                }
              ],
              "safeOutputs": [
                {
                  "collection": "accounts",
                  "itemsPath": "accounts",
                  "maxItems": 100,
                  "fields": {
                    "template-name": {
                      "path": "name",
                      "type": "string",
                      "required": true
                    },
                    "template-type": {
                      "path": "type",
                      "type": "string",
                      "required": true
                    },
                    "template-code": {
                      "path": "code",
                      "type": "string",
                      "required": true
                    },
                    "template-subtype": {
                      "path": "subtype",
                      "type": "string"
                    },
                    "template-description": {
                      "path": "description",
                      "type": "string"
                    },
                    "template-control": {
                      "path": "controlAccount",
                      "type": "boolean"
                    },
                    "template-reconcile": {
                      "path": "reconcileAccount",
                      "type": "boolean"
                    },
                    "template-active": {
                      "path": "isActive",
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "review-chart-template",
            "command": "review.import",
            "with": {
              "targetEntity": "accounts",
              "target": {},
              "source": "$steps.fetch-chart-template.safeOutput.accounts",
              "fields": {
                "name": "template-name",
                "type": "template-type",
                "code": "template-code",
                "subtype": "template-subtype",
                "description": "template-description",
                "controlAccount": "template-control",
                "reconcileAccount": "template-reconcile",
                "isActive": "template-active"
              }
            }
          }
        ]
      }
    ]
  }
}
