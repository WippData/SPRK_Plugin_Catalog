{
  "schemaVersion": "2",
  "extensionId": "pending-bank-review",
  "type": "report",
  "name": "Pending Bank Review",
  "version": "1.0.0",
  "description": "Active bank transactions still waiting for native review and confirmation.",
  "targets": {
    "companyScoped": true
  },
  "definition": {
    "definitionVersion": "2",
    "report": {
      "reportId": "pending-bank-review",
      "title": "Pending Bank Review",
      "category": "Banking",
      "description": "Active bank transactions still waiting for native review and confirmation. This is bank evidence, not posted accounting activity."
    },
    "data": {
      "source": "bank.register",
      "grain": "bank_transaction",
      "basis": {
        "kind": "bank_evidence",
        "dateField": "bank.date",
        "amountMode": "base_currency",
        "postingState": "non_posting"
      },
      "requiredFilters": [
        {
          "field": "bank.isActive",
          "op": "eq",
          "value": true
        },
        {
          "field": "bank.status",
          "op": "eq",
          "value": "pending"
        }
      ],
      "exposedFilters": [
        {
          "field": "bank.date",
          "label": "Bank date",
          "ops": [
            "between",
            "gte",
            "lte"
          ]
        },
        {
          "field": "account.name",
          "label": "Bank account",
          "ops": [
            "eq",
            "contains",
            "in"
          ]
        },
        {
          "field": "bank.direction",
          "label": "Direction",
          "ops": [
            "eq",
            "in"
          ]
        }
      ],
      "defaultSort": [
        {
          "field": "bank.date",
          "direction": "asc"
        },
        {
          "field": "account.name",
          "direction": "asc"
        }
      ]
    },
    "views": [
      {
        "viewId": "detail",
        "kind": "table",
        "label": "Pending transactions",
        "columns": [
          "bank.date",
          "account.name",
          "bank.description",
          "vendor.name",
          "bank.direction",
          "bank.received",
          "bank.spent",
          "bank.amount"
        ]
      }
    ],
    "customization": {
      "allowUserFilters": true,
      "allowUserGroupBy": false,
      "allowSavedViews": true,
      "maxGroupLevels": 0
    }
  }
}
