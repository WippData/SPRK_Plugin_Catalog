{
  "schemaVersion": "2", "extensionId": "fixed-assets", "type": "accounting_schedule", "name": "Fixed Assets", "version": "1.0.0",
  "description": "Straight-line monthly depreciation schedules.", "targets": { "companyScoped": true },
  "definition": {
    "definitionVersion": "2",
    "schedule": { "scheduleId": "fixed-assets", "title": "Fixed Assets", "description": "Track equal-month depreciation at month-end.", "icon": "landmark", "category": "Accounting schedules", "route": "fixed-assets" },
    "templates": [{ "templateId": "straight-line-monthly", "name": "Straight-line monthly", "calculationMethod": "straight_line_monthly", "postingFrequency": "monthly", "roundingPolicy": "final_period", "headerDefaults": { "salvageValue": 0, "openingAccumulatedDepreciation": 0 }, "requireApproval": true }],
    "fields": [
      { "fieldId": "assetName", "label": "Asset name", "dataType": "string", "required": true, "ui": { "table": { "visible": true, "width": 220 }, "drawer": { "input": "text", "visible": true } } },
      { "fieldId": "description", "label": "Description", "dataType": "string", "required": false, "ui": { "table": { "visible": false }, "drawer": { "input": "textarea", "visible": true } } },
      { "fieldId": "sourceReference", "label": "Source reference", "dataType": "string", "required": true, "tooltip": "Reference for the originating purchase or supporting document.", "ui": { "table": { "visible": true, "width": 160 }, "drawer": { "input": "text", "visible": true } } },
      { "fieldId": "costBasis", "label": "Cost basis", "dataType": "currency", "required": true, "ui": { "table": { "visible": true, "width": 140 }, "drawer": { "input": "number", "visible": true } } },
      { "fieldId": "salvageValue", "label": "Salvage value", "dataType": "currency", "required": false, "defaultValue": 0, "ui": { "table": { "visible": false }, "drawer": { "input": "number", "visible": true } } },
      { "fieldId": "inServiceDate", "label": "In-service date", "dataType": "date", "required": true, "ui": { "table": { "visible": true, "width": 130 }, "drawer": { "input": "date", "visible": true } } },
      { "fieldId": "usefulLifeMonths", "label": "Useful life (months)", "dataType": "number", "required": true, "ui": { "table": { "visible": true, "width": 150 }, "drawer": { "input": "number", "visible": true } } },
      { "fieldId": "openingAccumulatedDepreciation", "label": "Opening accumulated depreciation", "dataType": "currency", "required": false, "defaultValue": 0, "ui": { "table": { "visible": false }, "drawer": { "input": "number", "visible": true } } },
      { "fieldId": "openingRecognizedThrough", "label": "Opening recognized through", "dataType": "date", "required": false, "ui": { "table": { "visible": false }, "drawer": { "input": "date", "visible": true } } }
    ],
    "accountRoles": [
      { "roleId": "fixedAssetAccountId", "label": "Fixed asset account", "required": false, "accountTypes": ["asset"] },
      { "roleId": "depreciationExpenseAccountId", "label": "Depreciation expense account", "required": true, "accountTypes": ["expense"] },
      { "roleId": "accumulatedDepreciationAccountId", "label": "Accumulated depreciation account", "required": true, "accountTypes": ["asset"] }
    ],
    "calculation": { "methods": ["straight_line_monthly"], "defaultMethod": "straight_line_monthly", "amountSource": "costBasis", "startDateSource": "inServiceDate", "periodCountSource": "usefulLifeMonths", "salvageValueSource": "salvageValue", "openingRecognizedAmountSource": "openingAccumulatedDepreciation", "openingRecognizedThroughSource": "openingRecognizedThrough", "postingConvention": "month_end", "frequency": "monthly", "roundingPolicy": "final_period" },
    "posting": { "mode": "recognition_only", "dateSource": "postDate", "entryNoPattern": "FA-{{schedule.id}}-{{line.sequence}}", "memoPattern": "Fixed asset depreciation through {{line.periodEnd}}", "idempotencyKeyPattern": "accounting-schedules:fixed-assets:{{schedule.id}}:{{line.id}}", "lines": [
      { "accountRoleId": "depreciationExpenseAccountId", "description": "Depreciation expense", "debit": "line.amount" },
      { "accountRoleId": "accumulatedDepreciationAccountId", "description": "Accumulated depreciation", "credit": "line.amount" }
    ] }
  }
}
