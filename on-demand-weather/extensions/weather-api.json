{
  "schemaVersion": "2",
  "extensionId": "demo-weather-api",
  "type": "api_calls",
  "name": "Open-Meteo Weather API",
  "version": "1.0.0",
  "description": "No-auth Open-Meteo weather endpoint for connector smoke testing.",
  "targets": {
    "companyScoped": true
  },
  "definition": {
    "apiId": "open-meteo-weather",
    "baseUrl": "https://api.open-meteo.com",
    "operations": [
      {
        "operationId": "current-weather",
        "label": "Current Weather",
        "method": "GET",
        "path": "/v1/forecast",
        "query": {
          "latitude": "36.1627",
          "longitude": "-86.7816",
          "current": "temperature_2m"
        }
      }
    ]
  }
}
